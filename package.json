{
  "name": "shoppe",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:auth:browser": "node scripts/check-auth-browser.mjs",
    "lint:styles": "stylelint \"**/*.{vue,scss}\"",
    "format": "prettier --write .",
    "lint:fix": "npm run format && npm run lint:styles -- --fix && npm run lint -- --fix",
    "prepare": "husky",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "api:fixtures": "node scripts/fixtures/product-api.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:related": "node scripts/test-unit-related.mjs"
  },
  "dependencies": {
    "@vee-validate/rules": "^4.15.1",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "swiper": "^12.1.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.2.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "msw": "2.7.3",
    "nuxt": "3.17.3",
    "ofetch": "1.5.1",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.99.0",
    "stylelint": "^16.21.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix",
    "*.{vue,scss}": "stylelint --fix",
    "*.{js,ts,vue,scss,md,json}": "prettier --write",
    "*.{js,mjs,ts,vue,json}": "npm run test:unit:related --"
  }
}
